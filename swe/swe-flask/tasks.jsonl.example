{"instance_id": "swe-flask-0001", "repo": "pallets/flask", "base_commit": "22d924701a6ae2e4cd01e9a15bbaf3946094af65", "problem_statement": "Config.from_prefixed_env parses nested keys split on '__' but silently drops the value when an intermediate key exists and is not a dict, instead of raising a clear error. Make the collision raise a ValueError naming the conflicting key.", "target_files": ["src/flask/config.py"], "grading_command": "cd /repo && python -m pytest tests/test_config.py -q", "fail_to_pass": ["tests/test_config.py"], "pass_to_pass": ["tests/test_helpers.py"]}
{"instance_id": "swe-flask-0002", "repo": "pallets/flask", "base_commit": "22d924701a6ae2e4cd01e9a15bbaf3946094af65", "problem_statement": "Nested blueprints registered with a url_prefix ending in '/' produce routes containing '//' when the child blueprint also sets a prefix. Normalize prefix joining so exactly one slash separates the segments.", "target_files": ["src/flask/blueprints.py"], "grading_command": "cd /repo && python -m pytest tests/test_blueprints.py -q -k 'prefix or nested'", "fail_to_pass": ["tests/test_blueprints.py"], "pass_to_pass": ["tests/test_basic.py"]}
{"instance_id": "swe-flask-0003", "repo": "pallets/flask", "base_commit": "22d924701a6ae2e4cd01e9a15bbaf3946094af65", "problem_statement": "send_file guesses the wrong mimetype for filenames with uppercase extensions (e.g. REPORT.PDF) because the extension lookup is case-sensitive. Lower-case the extension before the mimetype lookup.", "target_files": ["src/flask/helpers.py"], "grading_command": "cd /repo && python -m pytest tests/test_helpers.py -q -k 'send_file or mimetype'", "fail_to_pass": ["tests/test_helpers.py"], "pass_to_pass": ["tests/test_config.py"]}
